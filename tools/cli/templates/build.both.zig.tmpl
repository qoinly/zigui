const std = @import("std");
const zigui = @import("zigui");

pub fn build(b: *std.Build) void {
    const target = b.standardTargetOptions(.{});
    const optimize = b.standardOptimizeOption(.{});

    // Desktop build: `zig build desktop` runs it ("run" is the APK install below).
    const zigui_mod = b.dependency("zigui", .{
        .target = target,
        .optimize = optimize,
    }).module("zigui");
    const exe = b.addExecutable(.{
        .name = "{{ident}}",
        .root_module = b.createModule(.{
            .root_source_file = b.path("src/main.zig"),
            .target = target,
            .optimize = optimize,
            .imports = &.{.{ .name = "zigui", .module = zigui_mod }},
        }),
    });
    b.installArtifact(exe);
    const run = b.addRunArtifact(exe);
    run.step.dependOn(b.getInstallStep());
    const desktop_step = b.step("desktop", "Run the desktop build");
    desktop_step.dependOn(&run.step);

    // Android build: packages the APK; `zig build run` installs + launches it.
    zigui.androidApk(b, .{
        .name = "{{ident}}",
        .source = b.path("src/main.zig"),
        .manifest = b.path("android/AndroidManifest.xml"),
        .package_name = "{{package}}",
        .optimize = optimize,
        .out_name = "{{ident}}.apk",
    });
}
