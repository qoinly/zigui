const zigui = @import("zigui");

// The mobile backends own the run loop (App.run never returns, or returns immediately on
// Android), so the state lives as a container-scoped var - not a stack local - and there is
// no defer app.deinit(). This works for the desktop target too.
const App = struct { taps: u32 = 0 };
var state: App = .{};

fn view(f: *zigui.Frame, app: *App) *zigui.Node {
    _ = f;
    _ = app;
    return zigui.col(.{ .pad = .lg, .gap = .md, .grow = 1 }, &.{
        zigui.text("Hello, {{display}}.", .{ .size = 28 }),
        zigui.button("Tap me", .{ .on_click = zigui.on(App, on_tap) }),
    });
}

fn on_tap(app: *App) void {
    app.taps += 1;
}

pub fn main() !void {
    var window = try zigui.App.init(.{ .title = "{{display}}", .size = .{ 900, 600 } });
    try window.run(&state, .{ .body = view });
}

// Keeps ANativeActivity_onCreate reachable in the Android .so; a no-op elsewhere.
comptime {
    _ = zigui.App;
}
